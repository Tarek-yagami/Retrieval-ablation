# Which model the LLM-as-judge / generation layer calls (see src/hybridrag/llm.py).
# litellm resolves the string to whichever provider it names:
#   claude-sonnet-5              -> Anthropic (needs ANTHROPIC_API_KEY)
#   gpt-4o                       -> OpenAI     (needs OPENAI_API_KEY)
#   groq/llama-3.3-70b-versatile -> Groq        (needs GROQ_API_KEY)
#   ollama/llama3.1               -> local Ollama (no key needed, needs Ollama running)
HYBRIDRAG_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
